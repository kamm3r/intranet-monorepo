{
  "name": "intranet-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:users": "turbo run dev --filter=@intranet/users-api --filter=@intranet/users-web --parallel",
    "dev:portal": "turbo run dev --filter=@intranet/portal-api --filter=@intranet/portal-web --parallel",
    "dev:kuutio": "turbo run dev --filter=@intranet/kuutio-api --filter=@intranet/kuutio-web --parallel",
    "dev:tyoaika": "turbo run dev --filter=@intranet/tyoaika-api --filter=@intranet/tyoaika-web --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "install:all": "pnpm install -r"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "prettier": "^3.5.3"
  }
}
