# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages/auth-server/package.json ./packages/auth-server/
COPY packages/auth-client/package.json ./packages/auth-client/
ARG APP
ARG WEB
COPY apps/${APP}/package.json ./apps/${APP}/
COPY apps/${WEB}/package.json ./apps/${WEB}/
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

FROM deps AS webbuild
COPY packages/auth-server/ ./packages/auth-server/
COPY packages/auth-client/ ./packages/auth-client/
COPY apps/${WEB}/ ./apps/${WEB}/
WORKDIR /app/apps/${WEB}
RUN pnpm build

FROM deps AS apibuild
COPY packages/ ./packages/
COPY apps/${APP}/ ./apps/${APP}/
WORKDIR /app/apps/${APP}
RUN pnpm build

FROM deps AS runner
COPY packages/ ./packages/
COPY apps/${APP}/ ./apps/${APP}/
COPY --from=apibuild /app/apps/${APP}/dist ./apps/${APP}/dist
COPY --from=webbuild /app/apps/${WEB}/dist ./apps/${WEB}/dist
WORKDIR /app/apps/${APP}
ENV NODE_ENV=production
EXPOSE 4000
CMD ["node", "--env-file=.env", "dist/index.js"]
