# portal-api server env (port default 4002).
# Loaded via Node's --env-file flag, e.g.:
#   dev:   tsx watch --env-file=.env index.ts
#   start: node --env-file=.env dist/index.js
PORT=4002
NODE_ENV=development

# Users service this portal delegates authorization to.
USERS_URL=http://localhost:4001

# Shared secret the users service sends as `service_key` on POST /api/authorize.
SERVICE_KEY=dev-portal-key-change-me
