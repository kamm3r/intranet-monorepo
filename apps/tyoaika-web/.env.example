# tyoaika-web client env (vite dev port default 5176)
# Canonical names first; *_DEV variants are read as fallbacks (see src/config.js).

# This app's own API origin (default http://localhost:4004 — NO /api suffix,
# this client appends /api/... paths itself, see src/api/authorize.js).
VITE_API_URL=http://localhost:4004
# VITE_API_URL_DEV=http://localhost:4004

# Users service API (default http://localhost:4001).
VITE_USERS_URL=http://localhost:4001
# VITE_USERS_URL_DEV=http://localhost:4001

# This client's own public URL (default http://localhost:5176).
VITE_DOMAIN=http://localhost:5176
# VITE_DOMAIN_DEV=http://localhost:5176
