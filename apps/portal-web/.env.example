# portal-web client env (vite dev port default 5172)
# Canonical names first; *_DEV variants are read as fallbacks (see src/config.ts).

# This portal's own API (default http://localhost:4002/api — note /api suffix,
# clients append paths like /authorize).
VITE_API_URL=http://localhost:4002/api
# VITE_API_URL_DEV=http://localhost:4002/api

# Users service API (default http://localhost:4001).
VITE_USERS_URL=http://localhost:4001
# VITE_USERS_URL_DEV=http://localhost:4001

# This client's own public URL (default http://localhost:5172).
VITE_DOMAIN=http://localhost:5172
# VITE_DOMAIN_DEV=http://localhost:5172
