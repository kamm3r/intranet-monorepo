# Kuutio web (apps/kuutio-web) — canonical Vite vars with local defaults.
# NOTE: VITE_API_URL includes the /api suffix (clients append /authorize, /booking).
VITE_API_URL=http://localhost:4003/api
VITE_USERS_URL=http://localhost:4001
VITE_DOMAIN=http://localhost:5175

# Legacy fallbacks still read by src/config.js (only if canonical vars are unset):
# VITE_API_URL_DEV=http://localhost:4003/api
# VITE_API_URL_PROD=https://kuutio-api.example.com/api
# VITE_USERS_URL_DEV=http://localhost:4001
