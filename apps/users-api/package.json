{
  "name": "@intranet/users-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -b",
    "test": "NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --verbose --runInBand",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node --env-file=.env --import tsx scripts/seedDemo.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.90.0",
    "@effect/platform-node": "^0.95.0",
    "bcrypt": "^6.0.0",
    "effect": "^3.17.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.4",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalTeardown": "./tests/teardown.js"
  }
}
