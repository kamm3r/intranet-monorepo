# tyoaika-api server env (port default 4004).
# Loaded via Node's --env-file flag, e.g.:
#   dev:   tsx watch --env-file=.env index.ts
#   start: node --env-file=.env dist/index.js
PORT=4004
NODE_ENV=development

# Mongo — canonical name; MONGO_URI is read as a legacy fallback.
MONGODB_URI=mongodb://localhost:27017/tyoaika-dev
# MONGO_URI=mongodb://localhost:27017/tyoaika-dev

# Users service this app delegates authorization to.
USERS_URL=http://localhost:4001

# Service identity (checked against users-service on POST /api/authorize).
SERVICE_NAME=tyoaika

# Shared secret the users service sends as `service_key` on POST /api/authorize.
SERVICE_KEY=dev-tyoaika-key-change-me
