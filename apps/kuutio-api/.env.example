# Kuutio API (apps/kuutio-api) — SSO via the users service (Effect TS).
# Loaded with Node >=22 `--env-file=.env` (no dotenv package).
# Dev: `tsx watch --env-file=.env index.ts`
PORT=4003
NODE_ENV=development

# Canonical URI; legacy MONGODB_URI_DEV / MONGODB_URI_PROD still work as fallback.
MONGODB_URI=mongodb://localhost:27017/kuutio-dev
# MONGODB_URI_DEV=mongodb://localhost:27017/kuutio-dev
# MONGODB_URI_PROD=mongodb+srv://<user>:<pass>@<cluster>/kuutio-prod

# Canonical users-service URL; legacy USERS_URL_DEV / USERS_URL_PROD still work.
USERS_URL=http://localhost:4001
# USERS_URL_DEV=http://localhost:4001
# USERS_URL_PROD=https://users.example.com

# Canonical service name; legacy SERVICE_NAME_DEV still works.
SERVICE_NAME=kuutio
# SERVICE_NAME_DEV=kuutio

# Canonical shared secret with the users service; legacy SERVICE_KEY_DEV / SERVICE_KEY_PROD still work.
SERVICE_KEY=dev-kuutio-key-change-me
# SERVICE_KEY_DEV=dev-kuutio-key-change-me
# SERVICE_KEY_PROD=<prod-secret-here>
